# PlaceMellon configuration. Every setting is optional; these are the
# defaults. Copy to an env file and pass it with --env-file. See
# DEPLOYMENT.md#configuration.

# Port the application listens on
PORT=3000

# Hours between catalog refreshes; preview-link expiry can refresh sooner
REFRESH_HOURS=6

# Rendered images cached in memory; 0 disables the cache
CACHE_ENTRIES=256
