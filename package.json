{
  "name": "cmu-web-placemellon",
  "version": "2.3.11",
  "private": true,
  "description": "Placeholder images for Carnegie Mellon websites and apps",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "preview:kilt": "sh -c 'k=${KILT_DIR:-../cmu-web-kilt}; [ -f \"$k/tools/preview.mjs\" ] || { echo \"No Web Kilt checkout with the preview proxy at $k (set KILT_DIR)\" >&2; exit 1; }; exec node \"$k/tools/preview.mjs\" --proxy http://localhost:${PORT:-3200}'",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:node": "node scripts/check-node-version.mjs",
    "check:opengraph": "node scripts/opengraph.mjs --check",
    "opengraph": "node scripts/opengraph.mjs",
    "check": "npm run check:node && npm run lint && npm run format:check && npm run check:opengraph && npm run typecheck && npm test && npm run check:docs && npm run check:kilt",
    "docs": "npm run build && node scripts/documentation.mjs",
    "check:docs": "npm run build && node scripts/documentation.mjs --check",
    "kilt": "cmu-web-kilt-links docs",
    "check:kilt": "cmu-web-kilt-links --check docs"
  },
  "dependencies": {
    "express": "^5.3.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@cmu-web/kilt": "0.8.24",
    "@eslint/js": "^10.0.1",
    "@j178/prek": "^0.5.11",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.0"
  },
  "license": "BSD-3-Clause",
  "allowScripts": {
    "esbuild": false
  }
}
